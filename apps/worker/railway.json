{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "packages/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      ".npmrc",
      ".dockerignore"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "preDeployCommand": "node --import tsx node_modules/@sbos/db/src/cli/migrate.ts",
    "preDeployTimeoutSeconds": 600,
    "healthcheckPath": "/healthz",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 60
  }
}
