# Second Brain Business OS — local development
# Copy to .env and adjust. Never commit real secrets.

# Postgres (docker compose default). The app role is NOT a superuser so RLS applies.
DATABASE_URL=postgres://sbos:sbos@localhost:5432/sbos_dev
DATABASE_URL_TEST=postgres://sbos:sbos@localhost:5432/sbos_test
# Migration role (owner of the schema; bypasses RLS). Local dev may reuse the app role.
DATABASE_URL_MIGRATE=postgres://sbos:sbos@localhost:5432/sbos_dev

# LLM provider (Milestone 1+). Leave empty to run agents in "simulated" mode.
ANTHROPIC_API_KEY=
SBOS_DEFAULT_MODEL=claude-sonnet-5-5

# Auth (Milestone 1). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Observability (optional, Milestone 5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
