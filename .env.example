# Second Brain Business OS — local development
# Copy to .env and adjust. Never commit real secrets.

# Postgres (docker compose default). The app role is NOT a superuser so RLS applies.
DATABASE_URL=postgres://sbos:sbos@localhost:5432/sbos_dev
DATABASE_URL_TEST=postgres://sbos:sbos@localhost:5432/sbos_test
# Migration role (owner of the schema; bypasses RLS). Local dev may reuse the app role.
DATABASE_URL_MIGRATE=postgres://sbos:sbos@localhost:5432/sbos_dev

# LLM provider (Milestone 1+). Leave empty to run agents in "simulated" mode.
ANTHROPIC_API_KEY=
SBOS_DEFAULT_MODEL=claude-sonnet-5-5

# Auth (Milestone 1). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Observability (optional, Milestone 5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# ----------------------------------------------------------------------------------------------
# Deployment (Milestone 1, ticket M1-16). See docs/deployment.md for which service gets which
# variable. Railway sets PORT itself; Docker Compose sets it per service. Secrets are set in the
# platform (Railway variables or .env.production on the server), never committed.
# ----------------------------------------------------------------------------------------------
# HTTP port. Web defaults to 3000, worker to 8080 (GET /healthz). Railway overrides this.
PORT=3000
# Public hostname of the platform (no scheme). Caddy obtains the TLS certificate for it on the
# Hetzner path; Railway uses its own domain settings. Also used to build deep links in notifications.
SBOS_DOMAIN=localhost
# Pumble incoming webhook for internal operational notifications (ADR-018). Worker only.
PUMBLE_WEBHOOK_URL=
# Resend API key and verified sender for formal e-mail (ADR-018). Worker only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Second Brain OS <noreply@example.com>
# Number of pg-boss jobs one worker process handles concurrently.
SBOS_WORKER_CONCURRENCY=2
# Platform-wide monthly model spend cap in USD (ADR-016). 80% warns, 100% hard-stops.
SBOS_PLATFORM_BUDGET_USD_MONTH=25

# Auth pool (M1-01). Better Auth tables live in schema `auth`; this pool connects as the schema owner.
# Optional: defaults to DATABASE_URL_MIGRATE, then DATABASE_URL.
DATABASE_URL_AUTH=

# Transactional mail for authentication (verification, password reset, invitations).
# Without RESEND_API_KEY messages are printed to the server console with the prefix [mail:dev].
RESEND_API_KEY=
# Sender shown by Resend, e.g. "Second Brain <no-reply@yourdomain>". Required when RESEND_API_KEY is set.
MAIL_FROM=

# Optional social sign-in (ADR-015). A provider is enabled only when both of its variables are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Entra tenant: "common", "organizations", "consumers" or a tenant id. Defaults to common.
MICROSOFT_TENANT_ID=

# Dev bootstrap of the first superadmin: pnpm --filter @sbos/web bootstrap-admin
SBOS_ADMIN_EMAIL=
SBOS_ADMIN_PASSWORD=
SBOS_ADMIN_NAME=
